generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(uuid())
  username     String
  email        String     @unique
  passwordHash String
  role         String     @default("user")
  createdAt    DateTime   @default(now())
  cards        UserCard[]
}

model Set {
  id          String   @id
  name        String
  series      String?
  total       Int
  releaseDate DateTime?
  logoUrl     String?
  cards       Card[]
}

model Card {
  id         String     @id
  set        Set        @relation(fields: [setId], references: [id])
  setId      String
  name       String
  number     String
  rarity     String
  imageSmall String?
  imageLarge String?
  owners     UserCard[]
}

model UserCard {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  card       Card     @relation(fields: [cardId], references: [id])
  cardId     String
  quantity   Int      @default(1)
  obtainedAt DateTime @default(now())

  @@unique([userId, cardId])
}